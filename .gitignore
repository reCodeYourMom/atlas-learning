# .gitignore racine (dépôt = atlas_dossier : docs + pivots + code).
# 04_code/.gitignore reste en place pour son sous-arbre (redondance volontaire).

# === Secrets — JAMAIS commités (les *.example / *.template restent versionnés) ===
.env
.env.local
**/SECRETS.local.txt

# === Python ===
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# === Node / Next.js ===
node_modules/
.next/
out/

# === SQLite : DB = artefact regénérable (convention existante), jamais versionnée ===
*.db
*.db-journal
*.db-wal
*.db-shm

# === OS / éditeur ===
.DS_Store
*.swp
.idea/
.vscode/
