# =====================================================================
# Atlas — stack DÉMO (deploy/demo). Copier en `.env` SUR LA VM. Jamais versionné.
# deploy.sh remplit tout seul les valeurs laissées en __REMPLACER__.
# =====================================================================

# --- Le sous-domaine de la démo (un enregistrement A → IP de la VM) ---
# Le domaine racine et son www restent chez leur hébergeur actuel : rien ici ne les touche.
DEMO_DOMAIN=demo.atlaslearning.ae

# --- Mot de passe partagé des 5 comptes de démo ---
# Généré par deploy.sh dans une forme tapable en visio (ex. Atlas-hK7mqRt2xv).
# Change-le à la main quand tu veux : docker compose up -d backend suffit à l'appliquer.
DEMO_LOGIN_PASSWORD=__REMPLACER__

# --- Secrets d'infrastructure (générés par deploy.sh) ---
AUTH_SECRET=__REMPLACER__          # HMAC des jetons de session
APP_DB_USER=atlas
APP_DB_PASSWORD=__REMPLACER__      # Postgres applicatif

# --- Semis au premier boot ---
# 1 = semer si la base est vide (défaut). Le mettre à 0 empêche tout semis automatique.
DEMO_SEED_ON_BOOT=1

# Aucune clé LLM n'est nécessaire : la banque d'items et sa version arabe sont
# déterministes. C'est délibéré — pas d'appel réseau sur le chemin d'une démo.
