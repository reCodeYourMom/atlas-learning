# Copier en terraform.tfvars (gitignoré) et renseigner.
# Les 4 premières valeurs viennent de : OCI Console → Profil → User settings → API Keys
# (« Add API Key » génère la clé privée + affiche un bloc de config avec ces OCIDs).

tenancy_ocid     = "ocid1.tenancy.oc1..xxxxx"
user_ocid        = "ocid1.user.oc1..xxxxx"
fingerprint      = "aa:bb:cc:dd:..."          # empreinte de la clé API
private_key_path = "~/.oci/atlas_api_key.pem" # clé privée API téléchargée
compartment_ocid = "ocid1.tenancy.oc1..xxxxx" # = tenancy_ocid pour le compartment racine

region = "me-abudhabi-1"                       # home region = UAE Central (Abu Dhabi). ⚠ DOIT être ta home region (Always Free)

ssh_public_key_path = "~/.ssh/id_ed25519.pub"
ssh_ingress_cidr    = "0.0.0.0/0"             # mets "TON.IP.PUB.LIC/32" pour durcir le SSH

# CMK OCI Vault pour chiffrer le boot volume à la création (données mineurs, RUNBOOK-BETA §1).
# Créer la clé AVANT l'apply : Console → Identity & Security → Vault → Master Encryption Key.
# Vide = clé Oracle par défaut (chiffré, mais Oracle détient la clé).
# Pour la DÉMO (données fictives), on peut laisser vide sans conséquence.
boot_kms_key_ocid = ""                        # "ocid1.key.oc1.me-abudhabi-1.xxxxx"

# =====================================================================
# Profil de déploiement
# =====================================================================
# "demo" → demo/deploy : UN sous-domaine, sans Keycloak, connexion par mot de passe
#          partagé. C'est la stack des rendez-vous écoles.
# "prod" → deploy/prod : SSO Keycloak + TOTP, deux sous-domaines. Pour un vrai pilote.
deploy_profile = "demo"

# --- Profil demo : un seul sous-domaine ---
demo_domain = "demo.atlaslearning.ae"

# --- Profil prod uniquement (laisser vides en demo) ---
app_domain  = ""
auth_domain = ""

# Optionnel : si renseigné, cloud-init clone et déploie tout seul.
# Laisse vide pour copier le bundle en scp et lancer deploy.sh à la main.
repo_url = ""
