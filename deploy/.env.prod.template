# =====================================================================
# Atlas Learning — variables d'environnement PRODUCTION (template)
# Copier en .env (gitignoré) sur le serveur, ou charger via secret manager.
# Référence : runbook §2. Vérifié contre le code (src/) le 2026-06-21.
# =====================================================================

# ---------------------------------------------------------------------
# CŒUR (obligatoire)
# ---------------------------------------------------------------------
# Postgres prod — région UAE (résidence GCC). Driver psycopg v3.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/atlas

# Clé HMAC des jetons. OBLIGATOIRE en prod (fail-fast actif si absente).
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
# Valeur réelle : voir deploy/SECRETS.local.txt (NON versionné).
AUTH_SECRET=__REMPLACER_PAR_LE_SECRET__

# Active le fail-fast sur AUTH_SECRET (src/rbac/auth.py).
ATLAS_ENV=prod

# Base du front — redirections SSO / liens magiques.
WEB_BASE_URL=https://app.atlas.example

# Génération d'items (existant).
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------
# SSO / OIDC  (un provider sans CLIENT_ID/SECRET est simplement absent
# de /auth/providers — voir src/rbac/oidc.py)
# ---------------------------------------------------------------------
OIDC_GOOGLE_CLIENT_ID=1044384395682-r6hd96bc1jo5jdt93ji1otg2si0lug9m.apps.googleusercontent.com
# Secret : copier depuis Google Cloud Console > Google Auth Platform > Clients
# > "Atlas Web (login + onboarding)". Mettre dans OCI Vault, jamais en clair.
OIDC_GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID (optionnel)
# OIDC_MICROSOFT_CLIENT_ID=
# OIDC_MICROSOFT_CLIENT_SECRET=
# OIDC_MICROSOFT_TENANT=common

# IdP OIDC générique (optionnel)
# OIDC_GENERIC_CLIENT_ID=
# OIDC_GENERIC_CLIENT_SECRET=
# OIDC_GENERIC_ISSUER=

# Base des redirect URI (défaut = WEB_BASE_URL si vide)
# TEMP : OAuth client créé avec localhost (pas de domaine prod fixé).
# Quand le domaine sera prêt : ajouter les 2 redirect URIs définitives dans la
# console (Clients > Atlas Web) et mettre OIDC_REDIRECT_BASE sur ce domaine.
OIDC_REDIRECT_BASE=http://localhost:8000

# ---------------------------------------------------------------------
# ROSTERING GOOGLE (Admin SDK + Classroom)
# ---------------------------------------------------------------------
# Clé service account vendeur : JSON inline OU chemin fichier (un des deux).
# GOOGLE_SA_KEY_JSON={"type":"service_account",...}
GOOGLE_SA_KEY_FILE=/secrets/atlas-sa.json

# 1 = activer les tuteurs Classroom (scope guardianlinks requis)
ROSTER_GUARDIANS=1

# ---------------------------------------------------------------------
# LICENCE & EMAIL
# ---------------------------------------------------------------------
# Quota de sièges par défaut à l'onboarding (vide = illimité).
DEFAULT_SEATS=

# Envoi des emails (liens magiques parents). Sans token → Noop (aucun email).
POSTMARK_TOKEN=
EMAIL_FROM=no-reply@atlas.example
