# =====================================================================
# Atlas — stack prod (deploy/prod). Copier en `.env` SUR LE SERVEUR (jamais versionné).
# Générer les secrets : python -c "import secrets; print(secrets.token_urlsafe(48))"
# =====================================================================

# --- Domaines (DNS A/AAAA → IP de la VM) ---
APP_DOMAIN=app.atlas.example          # front + /api
AUTH_DOMAIN=auth.atlas.example        # Keycloak (issuer OIDC)

# --- Secrets cœur ---
AUTH_SECRET=__REMPLACER__             # HMAC jetons de session (obligatoire, fail-fast prod)
APP_DB_USER=atlas
APP_DB_PASSWORD=__REMPLACER__         # Postgres applicatif (données GCC)

# --- Keycloak ---
KC_DB_PASSWORD=__REMPLACER__          # Postgres Keycloak
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=__REMPLACER__       # console admin Keycloak (auth.DOMAIN/admin)
# DOIT correspondre au "secret" du client atlas-web dans keycloak/atlas-realm.json
OIDC_GENERIC_CLIENT_ID=atlas-web
OIDC_GENERIC_CLIENT_SECRET=__REMPLACER_ET_SYNCHRONISER_AVEC_LE_REALM__
# Mot de passe INITIAL des 3 comptes démo Keycloak (admin@/prof@/parent@demo.atlas).
# Généré par deploy.sh si laissé en placeholder — jamais versionné, changé de force
# au 1er login (temporary + UPDATE_PASSWORD) puis TOTP obligatoire.
DEMO_ACCOUNTS_PASSWORD=__REMPLACER__

# --- Intégrations (optionnel) ---
GROQ_API_KEY=                         # génération/traduction d'items (vide = OK pour la démo)

# --- Email : envoi des liens magiques (parents / linguistes) ---
# Prod ATLAS = OCI Email Delivery (Abu Dhabi, résidence GCC, 3000 mails/mois Always Free).
# Identifiants SMTP générés dans OCI (Email Delivery > SMTP Credentials) — le mot de passe
# n'est affiché qu'UNE fois. Portée : soumission SMTP uniquement. Priorité dans le code :
# SMTP > Postmark > Noop (vide partout = aucun email envoyé).
SMTP_HOST=smtp.email.me-abudhabi-1.oci.oraclecloud.com
SMTP_PORT=587                          # STARTTLS, TLS 1.2 obligatoire
SMTP_USERNAME=                         # Username SMTP OCI
SMTP_PASSWORD=                         # Password SMTP OCI (non ré-affichable)
EMAIL_FROM=no-reply@mail.atlaslearning.ae   # approved sender OCI (domaine mail. vérifié)
POSTMARK_TOKEN=                        # alternatif (API HTTP) — laisser vide si SMTP utilisé

# --- Provision au boot ---
# 0 par défaut : en PROD on ne sème JAMAIS la démo. Passer à 1 UNIQUEMENT pour une
# instance de démonstration (crée tenant démo + users admin/prof/parent + données
# 4 mouvements), puis remettre 0 avant d'accueillir de vraies données élèves.
PROVISION_ON_BOOT=0
