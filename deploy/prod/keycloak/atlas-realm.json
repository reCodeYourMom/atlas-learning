{
  "realm": "atlas",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "clients": [
    {
      "clientId": "atlas-web",
      "name": "Atlas Web (login)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "CHANGE_ME_atlas_kc_client_secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8000/api/oauth/generic/callback",
        "http://localhost:3000/api/oauth/generic/callback",
        "https://*/api/oauth/generic/callback"
      ],
      "webOrigins": ["+"],
      "attributes": { "post.logout.redirect.uris": "+" },
      "protocolMappers": [
        {
          "name": "atlas-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "atlas-web",
            "id.token.claim": "true",
            "access.token.claim": "false"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "test@demo.atlas",
      "email": "test@demo.atlas",
      "firstName": "Smoke",
      "lastName": "Test",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "Test1234!", "temporary": false }]
    },
    {
      "username": "admin@demo.atlas",
      "email": "admin@demo.atlas",
      "firstName": "Demo",
      "lastName": "Admin",
      "emailVerified": true,
      "enabled": true,
      "requiredActions": ["CONFIGURE_TOTP"],
      "credentials": [{ "type": "password", "value": "ChangeMe1234!", "temporary": false }]
    },
    {
      "username": "prof@demo.atlas",
      "email": "prof@demo.atlas",
      "firstName": "Demo",
      "lastName": "Teacher",
      "emailVerified": true,
      "enabled": true,
      "requiredActions": ["CONFIGURE_TOTP"],
      "credentials": [{ "type": "password", "value": "ChangeMe1234!", "temporary": false }]
    },
    {
      "username": "parent@demo.atlas",
      "email": "parent@demo.atlas",
      "firstName": "Demo",
      "lastName": "Parent",
      "emailVerified": true,
      "enabled": true,
      "requiredActions": ["CONFIGURE_TOTP"],
      "credentials": [{ "type": "password", "value": "ChangeMe1234!", "temporary": false }]
    }
  ]
}
