{
  "realm": "atlas",
  "displayName": "Atlas — DÉRISQUAGE LOCAL (NE JAMAIS IMPORTER EN PROD)",
  "enabled": true,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "clients": [
    {
      "clientId": "atlas-web",
      "name": "Atlas Web (dérisquage local — secret factice, ROPC autorisé pour les smoke tests)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "derisk-local-only-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8000/api/oauth/generic/callback",
        "http://localhost:3000/api/oauth/generic/callback"
      ],
      "webOrigins": ["http://localhost:8000", "http://localhost:3000"],
      "attributes": { "post.logout.redirect.uris": "http://localhost:8000/*##http://localhost:3000/*" },
      "protocolMappers": [
        {
          "name": "atlas-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "atlas-web",
            "id.token.claim": "true",
            "access.token.claim": "false"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "test@demo.atlas",
      "email": "test@demo.atlas",
      "firstName": "Smoke",
      "lastName": "Test",
      "emailVerified": true,
      "enabled": true,
      "credentials": [{ "type": "password", "value": "Test1234!", "temporary": false }]
    }
  ]
}
