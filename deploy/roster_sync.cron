# Atlas Learning — sync rostering nocturne (runbook §6)
# Installer : crontab -e  (ou /etc/cron.d/atlas-roster)
# Idempotent. Une sync qui désactive massivement (≥8 ET ≥25%) est BLOQUÉE
# (RosterRun='blocked') → l'IT admin approuve dans la console (?force=true).
#
# Adapter : chemin /app, DATABASE_URL, GOOGLE_SA_KEY_FILE, interpréteur venv.

0 2 * * *  cd /app/04_code && \
  DATABASE_URL="postgresql+psycopg://USER:PASSWORD@HOST:5432/atlas" \
  GOOGLE_SA_KEY_FILE="/secrets/atlas-sa.json" \
  ROSTER_GUARDIANS=1 \
  /app/04_code/.venv/bin/python scripts/roster_sync.py \
  >> /var/log/atlas-roster.log 2>&1
